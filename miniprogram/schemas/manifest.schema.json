{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "latestWeekId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,64}$"
    },
    "weeks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          },
          "reportDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "title": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1
          },
          "url": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1
          }
        },
        "required": [
          "id",
          "reportDate",
          "title",
          "url"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "revision",
    "latestWeekId",
    "weeks"
  ]
}
