{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,64}$"
    },
    "reportDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "title": {
      "type": "string",
      "maxLength": 2000,
      "minLength": 1
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          },
          "category": {
            "enum": [
              "english",
              "poetry",
              "dizigui"
            ]
          },
          "mode": {
            "enum": [
              "learn",
              "review"
            ]
          },
          "lesson": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,64}$"
              },
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "url": {
                "type": "string",
                "maxLength": 2000,
                "minLength": 1
              }
            },
            "required": [
              "id",
              "version",
              "url"
            ]
          }
        },
        "required": [
          "id",
          "category",
          "mode",
          "lesson"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "reportDate",
    "title",
    "items"
  ]
}
