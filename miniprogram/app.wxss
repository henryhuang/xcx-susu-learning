page{background:#fff8e8;color:#40384e;font-family:ui-rounded,"Arial Rounded MT Bold",system-ui,sans-serif;font-size:32rpx;overflow-x:hidden}
view,text,button,image{box-sizing:border-box}
button{font:inherit;line-height:1.35}
button::after{border:0}
.page{min-height:100vh;padding:0 28rpx calc(42rpx + env(safe-area-inset-bottom));overflow-x:hidden}
.content{width:100%;max-width:1100rpx;margin:0 auto}
.paper{background:#fffdf8;border:5rpx solid #eee3d3;border-radius:44rpx;box-shadow:0 18rpx 38rpx rgba(72,61,86,.10);padding:32rpx}
.eyebrow{color:#e94e68;font-size:25rpx;font-weight:900;letter-spacing:2rpx}
.title{font-size:56rpx;line-height:1.18;font-weight:900;overflow-wrap:anywhere}
.muted{color:#746d7c;line-height:1.55}
.primary{display:flex;align-items:center;justify-content:center;min-height:96rpx;width:100%;padding:18rpx 28rpx;border-radius:28rpx;background:#ff6b81;color:#fff;font-size:34rpx;font-weight:900;box-shadow:0 9rpx 0 #e94e68;white-space:normal;text-align:center}
.primary:active,.primary.button-hover{transform:translateY(6rpx);box-shadow:0 3rpx 0 #e94e68}
.secondary{display:flex;align-items:center;justify-content:center;min-height:90rpx;padding:15rpx 20rpx;background:#fff;border:4rpx solid #e9ddcb;border-radius:25rpx;color:#40384e;font-size:29rpx;font-weight:850;white-space:normal}
.secondary:active,.secondary.button-hover{background:#fff1d8;transform:translateY(3rpx)}
.section-top{margin:28rpx 0 22rpx;text-align:center}
.section-top .title{display:block;margin:8rpx 0}.section-top .eyebrow,.section-top .muted{display:block}
.count-pill{display:inline-block;padding:9rpx 22rpx;border-radius:99rpx;background:#dff6f2;color:#257b70;font-size:26rpx;font-weight:900}
.art{font-size:112rpx;line-height:1.3;text-align:center;margin:20rpx auto}
.big-word{display:block;font-size:68rpx;font-weight:900;line-height:1.25;text-align:center;overflow-wrap:anywhere}
.prompt{display:block;font-size:42rpx;font-weight:850;line-height:1.35;text-align:center;overflow-wrap:anywhere;margin:20rpx 0}
.choice-row{display:flex;gap:14rpx;justify-content:center;flex-wrap:wrap;margin:22rpx 0}
.choice{display:flex;align-items:center;justify-content:center;text-align:center;flex:1 1 150rpx;min-height:100rpx;padding:15rpx 10rpx;border:4rpx solid #e9ddcb;background:#fff;border-radius:25rpx;color:#40384e;font-size:30rpx;font-weight:900;white-space:normal;overflow-wrap:anywhere}
.choice:active,.choice.button-hover{background:#fff1d8;transform:translateY(3rpx)}
.choice.selected{border-color:#51c6b7;background:#dff6f2}
.stack{display:flex;flex-direction:column;gap:22rpx}
.center{text-align:center}
.gap-top{margin-top:28rpx}
/* Pad sizes use px so rpx does not enlarge every control with the screen width. */
@media (min-width:700px){
  page{font-size:18px}
  .page{padding:0 32px calc(32px + env(safe-area-inset-bottom))}
  .content{max-width:960px}
  .lesson-page .content{max-width:800px}
  .paper{border-width:3px;border-radius:28px;padding:28px;box-shadow:0 10px 24px rgba(72,61,86,.10)}
  .eyebrow{font-size:15px;letter-spacing:1px}
  .title{font-size:34px}
  .primary{min-height:54px;padding:10px 20px;border-radius:18px;font-size:20px;box-shadow:0 5px 0 #e94e68}
  .secondary{min-height:50px;padding:8px 16px;border-width:2px;border-radius:16px;font-size:18px}
  .section-top{margin:20px 0 16px}
  .section-top .title{margin:6px 0}
  .count-pill{padding:6px 14px;font-size:16px}
  .art{font-size:72px;margin:10px auto}
  .big-word{font-size:48px}
  .prompt{font-size:28px;margin:12px 0}
  .choice-row{gap:12px;margin:16px 0;width:100%}
  .choice{flex:1 1 160px;min-height:58px;padding:10px 12px;border-width:2px;border-radius:16px;font-size:19px}
  .stack{gap:16px}
  .gap-top{margin-top:20px}
}
@media (min-width:900px) and (orientation:landscape){
  .page{padding-left:40px;padding-right:40px}
  .content{max-width:1080px}
  .lesson-page .content{max-width:820px}
  .lesson-page .primary{max-width:560px;margin-left:auto;margin-right:auto}
}
