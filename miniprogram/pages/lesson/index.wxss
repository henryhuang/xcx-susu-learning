.welcome,.finish{max-width:700rpx;margin:30rpx auto 0;display:flex;flex-direction:column;align-items:center;gap:22rpx}.welcome-title{display:block}.welcome .muted,.finish .muted{display:block;max-width:600rpx}.shape-symbol{display:block;font-size:160rpx;line-height:1.2;text-shadow:0 10rpx 10rpx rgba(72,61,86,.12)}.art{display:block}.final-star{font-size:40rpx;color:#d99e00;font-weight:900}.paper .muted{display:block}.paper sound-button{align-self:center}
.course-image{width:360rpx;height:300rpx}.stack{gap:20rpx}
.author{display:block;font-size:28rpx;color:#84726b}.poem-title{font-size:45rpx;font-weight:800}.verse-list,.explanation-list{width:100%}.verse{display:block;width:100%;padding:19rpx 10rpx;margin:8rpx 0;border-radius:20rpx;background:#fff8ef;color:#674354;font-size:34rpx;line-height:1.8;letter-spacing:2rpx;white-space:normal}.verse.active-verse{background:#fce3ec;color:#a33260}.verse-sound{font-size:23rpx;color:#b86f8c}.practice-line{font-size:42rpx;line-height:1.9;color:#674354;letter-spacing:3rpx}.explanation-item{padding:22rpx 0;border-bottom:2rpx solid #f2e4d8;text-align:left}.original-line{display:block;font-size:33rpx;font-weight:700;line-height:1.7;margin-bottom:10rpx}.explanation-art{font-size:100rpx}.chinese-lesson .eyebrow{color:#ad5579;letter-spacing:1rpx}.story-choices{flex-direction:column;width:100%;gap:15rpx}.story-choices .choice{width:100%;flex:none;white-space:normal;font-size:29rpx;line-height:1.6;padding:22rpx}.chinese-lesson .paper{border-color:#efdbdd}.chinese-lesson .title{font-size:48rpx}
@media (min-width:700px){
  .welcome,.finish{max-width:620px;margin-top:24px;gap:16px}
  .welcome .muted,.finish .muted{max-width:560px}
  .shape-symbol{font-size:96px}
  .final-star{font-size:27px}
  .course-image{width:260px;height:200px;max-width:100%}
  .author{font-size:17px}
  .poem-title{font-size:29px}
  .verse{padding:11px 12px;margin:6px 0;border-radius:14px;font-size:22px;letter-spacing:1px}
  .verse-sound{font-size:15px}
  .practice-line{font-size:27px;letter-spacing:1px}
  .explanation-item{padding:14px 0;border-bottom-width:1px}
  .original-line{font-size:21px;margin-bottom:6px}
  .explanation-art{font-size:68px}
  .story-choices{gap:10px}
  .story-choices .choice{font-size:19px;padding:12px}
  .chinese-lesson .title{font-size:32px}
  .stack{gap:14px}
}
@media (min-width:900px) and (orientation:landscape){
  .verse-list,.explanation-list{max-width:680px;margin:0 auto}
  .story-choices{max-width:680px;margin-left:auto;margin-right:auto}
}
