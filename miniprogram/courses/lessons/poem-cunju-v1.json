  "content": {
    "kind": "poem",
    "author": "高鼎",
    "dynasty": "清",
    "lines": [
      {
        "id": "line-1",
        "text": "草长莺飞二月天",
        "audio": "/chinese/assets/audio/poem-cunju-line-1.mp3",
        "explanation": "春天来了，小草长高了，黄莺在天空飞。"
      },
      {
        "id": "line-2",
        "text": "拂堤杨柳醉春烟",
        "audio": "/chinese/assets/audio/poem-cunju-line-2.mp3",
        "explanation": "堤边的柳条轻轻摇，春天的空气像薄薄的烟。"
      },
      {
        "id": "line-3",
        "text": "儿童散学归来早",
        "audio": "/chinese/assets/audio/poem-cunju-line-3.mp3",
        "explanation": "孩子们放学早早回到家。"
      },
      {
        "id": "line-4",
        "text": "忙趁东风放纸鸢",
        "audio": "/chinese/assets/audio/poem-cunju-line-4.mp3",
        "explanation": "趁着春风，大家赶紧去放风筝。"
      }
    ]
  },
