  "content": {
    "kind": "poem",
    "author": "苏轼",
    "dynasty": "宋",
    "lines": [
      {
        "id": "line-1",
        "text": "横看成岭侧成峰",
        "audio": "/chinese/assets/audio/poem-tixilinbi-line-1.mp3",
        "explanation": "从正面看是连绵的山岭，从侧面看是高高的山峰。"
      },
      {
        "id": "line-2",
        "text": "远近高低各不同",
        "audio": "/chinese/assets/audio/poem-tixilinbi-line-2.mp3",
        "explanation": "站得远近不同、高低不同，看到的山也不一样。"
      },
      {
        "id": "line-3",
        "text": "不识庐山真面目",
        "audio": "/chinese/assets/audio/poem-tixilinbi-line-3.mp3",
        "explanation": "为什么看不清庐山完整的样子呢？"
      },
      {
        "id": "line-4",
        "text": "只缘身在此山中",
        "audio": "/chinese/assets/audio/poem-tixilinbi-line-4.mp3",
        "explanation": "因为自己就在这座山里面呀。"
      }
    ]
  },
