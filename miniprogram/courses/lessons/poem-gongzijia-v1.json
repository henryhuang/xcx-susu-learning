  "content": {
    "kind": "poem",
    "author": "聂夷中",
    "dynasty": "唐",
    "lines": [
      {
        "id": "line-1",
        "text": "种花满西园",
        "audio": "/chinese/assets/audio/poem-gongzijia-line-1.mp3",
        "explanation": "园子里种满了花。"
      },
      {
        "id": "line-2",
        "text": "花发青楼道",
        "audio": "/chinese/assets/audio/poem-gongzijia-line-2.mp3",
        "explanation": "花儿开在楼边的小路旁。"
      },
      {
        "id": "line-3",
        "text": "花下一禾生",
        "audio": "/chinese/assets/audio/poem-gongzijia-line-3.mp3",
        "explanation": "花下面长出了一株禾苗。"
      },
      {
        "id": "line-4",
        "text": "去之为恶草",
        "audio": "/chinese/assets/audio/poem-gongzijia-line-4.mp3",
        "explanation": "有人把禾苗当作杂草拔掉了。禾苗可以长出粮食，也值得珍惜。"
      }
    ]
  },
