  "content": {
    "kind": "poem",
    "author": "刘禹锡",
    "dynasty": "唐",
    "lines": [
      {
        "id": "line-1",
        "text": "花面丫头十三四",
        "audio": "/chinese/assets/audio/poem-jizengxiaofan-line-1.mp3",
        "explanation": "诗里写了一位十三四岁、面容像花一样的少女。"
      },
      {
        "id": "line-2",
        "text": "春来绰约向人时",
        "audio": "/chinese/assets/audio/poem-jizengxiaofan-line-2.mp3",
        "explanation": "春天来了，她面对人们时，姿态柔美。"
      },
      {
        "id": "line-3",
        "text": "终须买取名春草",
        "audio": "/chinese/assets/audio/poem-jizengxiaofan-line-3.mp3",
        "explanation": "诗人说，要把她买来，取名叫春草。这是古代诗里的说法。"
      },
      {
        "id": "line-4",
        "text": "处处将行步步随",
        "audio": "/chinese/assets/audio/poem-jizengxiaofan-line-4.mp3",
        "explanation": "诗人想象，走到哪里，她都一步步跟随在身边。"
      }
    ]
  },
