:host{display:block;width:100%}
.practice{position:relative;margin-top:12rpx;padding:16rpx 18rpx 18rpx;border:2rpx solid #f0dfdc;border-radius:30rpx;background:#fff9f1;box-sizing:border-box;text-align:center;transition:background-color .3s,border-color .3s}
.practice.celebrating{background:#fff5d7;border-color:#f0c763}
.award-frame{position:relative;display:flex;align-items:center;justify-content:center;min-height:116rpx;isolation:isolate}
.award-glow{position:absolute;inset:0 10%;border-radius:50%;background:radial-gradient(ellipse,rgba(255,222,117,.38),rgba(255,222,117,0) 70%);opacity:0;pointer-events:none}
.award-stars{position:relative;display:flex;align-items:center;justify-content:center;gap:20rpx;z-index:1}
.award-star{display:block;width:94rpx;font-size:92rpx;line-height:1.18;font-family:Arial,sans-serif;text-align:center;transform-origin:50% 65%}
.star-filled{color:#edb321;text-shadow:0 4rpx 0 #c48910,0 9rpx 16rpx rgba(219,160,30,.2)}
.star-empty{color:#d4bda5}
.award-reveal .award-glow{animation:award-glow 1.8s ease-out}
.award-reveal .star-filled{animation:star-pop .8s cubic-bezier(.2,.8,.3,1.2) both}
.award-reveal .star-1{animation-delay:.2s}.award-reveal .star-2{animation-delay:.4s}
.award-sparks{position:absolute;inset:0;pointer-events:none}
.spark{position:absolute;width:10rpx;height:10rpx;border-radius:50%;background:#f3bf4a;animation:spark-fly 1.4s ease-out both}
.spark-a{left:15%;top:50%;--spark-x:-20rpx;--spark-y:-42rpx}.spark-b{left:36%;top:22%;background:#efa0ae;--spark-x:-8rpx;--spark-y:-24rpx}.spark-c{right:34%;top:18%;background:#8bcbb9;--spark-x:10rpx;--spark-y:-25rpx}.spark-d{right:15%;top:52%;--spark-x:20rpx;--spark-y:-40rpx}
.well-done{display:block;color:#936014;font-size:30rpx;font-weight:800;line-height:1.5;margin:4rpx 0 14rpx}
.practice-status,.message{display:block;font-size:25rpx;line-height:1.6;margin:6rpx 0 12rpx;color:#76576a}.message{margin-top:16rpx}
.recording-status{display:flex;align-items:center;justify-content:center;gap:16rpx}.recording-status .practice-status{margin:6rpx 0 12rpx;color:#ba435e}
.voice-wave{display:flex;align-items:center;gap:5rpx;height:36rpx;margin-bottom:6rpx}.wave-bar{width:6rpx;height:14rpx;border-radius:6rpx;background:#e86b87;animation:voice-wave .8s ease-in-out infinite alternate}.bar-b,.bar-d{animation-delay:.2s}.bar-c{animation-delay:.4s}.bar-e{animation-delay:.1s}
.scoring-status{animation:scoring-breathe 1.3s ease-in-out infinite}
.buttons{display:flex;flex-wrap:wrap;justify-content:center;gap:16rpx;margin:8rpx 0 0}
.record,.play{display:flex;align-items:center;justify-content:center;gap:16rpx;margin:0;min-width:216rpx;min-height:100rpx;padding:12rpx 24rpx;box-sizing:border-box;border-radius:52rpx;font-size:31rpx;line-height:1.6;font-weight:800;white-space:nowrap}
.record{background:#ec7895;color:#fff;box-shadow:0 6rpx 0 #cf5976}.record:after,.play:after{border:0}.record:active,.play:active{transform:translateY(3rpx)}
.stop{background:#da6077;box-shadow:0 6rpx 0 #bc465e}.play{background:#e0f2ed;color:#347c70;border:2rpx solid #bfdfd5;box-shadow:0 5rpx 0 #c6e2d9}
.mic-icon{position:relative;width:30rpx;height:38rpx;flex:none}.mic-head{position:absolute;left:9rpx;top:0;width:12rpx;height:22rpx;background:currentColor;border-radius:9rpx}.mic-cup{position:absolute;left:3rpx;top:13rpx;width:24rpx;height:18rpx;border:3rpx solid currentColor;border-top:0;border-radius:0 0 15rpx 15rpx;box-sizing:border-box}.mic-stem{position:absolute;left:13rpx;top:29rpx;width:4rpx;height:9rpx;background:currentColor}.stop-icon{width:26rpx;height:26rpx;border-radius:6rpx;background:currentColor;flex:none}.play-icon{font-size:28rpx;line-height:1}
.details{margin:16rpx auto 0;padding:4rpx 12rpx;background:transparent;color:#90796e;font-size:23rpx;line-height:1.8;white-space:normal}.details:after{border:0}.score-item{display:block;font-size:24rpx;line-height:1.7;color:#76576a}.inactive{opacity:.55}
@keyframes star-pop{0%{opacity:0;transform:translateY(22rpx) scale(.25) rotate(-18deg)}55%{opacity:1;transform:translateY(-8rpx) scale(1.3) rotate(8deg)}78%{transform:translateY(2rpx) scale(.94) rotate(-3deg)}100%{opacity:1;transform:translateY(0) scale(1) rotate(0)}}
@keyframes award-glow{0%{opacity:0;transform:scale(.55)}35%{opacity:1;transform:scale(1.25)}100%{opacity:0;transform:scale(1.4)}}
@keyframes spark-fly{0%,15%{opacity:0;transform:translate(0,0) scale(.5)}35%{opacity:1}100%{opacity:0;transform:translate(var(--spark-x),var(--spark-y)) scale(.2)}}
@keyframes voice-wave{from{height:10rpx}to{height:32rpx}}
@keyframes scoring-breathe{0%,100%{opacity:.55}50%{opacity:1}}
@media(min-width:700px){.practice{padding:14px 18px;margin-top:10px;border-radius:22px}.award-frame{min-height:88px}.award-stars{gap:18px}.award-star{width:70px;font-size:68px}.well-done{font-size:20px;margin:2px 0 12px}.practice-status,.message{font-size:17px}.record,.play{font-size:20px;min-width:150px;min-height:60px;padding:9px 20px;gap:10px}.details,.score-item{font-size:16px}.recording-status{gap:10px}}
@media(prefers-reduced-motion:reduce){.award-reveal .star-filled,.award-reveal .award-glow,.spark,.wave-bar,.scoring-status{animation:none}.award-sparks{display:none}}
